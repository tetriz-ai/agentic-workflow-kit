# Codex execpolicy rules from the agentic-workflow-kit bridge: commands an agent may never run
# (forbidden) and commands that need a human's approval (prompt). The pre-bash hook adds the
# matrix these prefix rules cannot express (a merge through any `gh api .../merge` path, a push
# to main or master in any spelling, pipe-to-shell installs).

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "Agents must not merge PRs. Use the normal human merge gate.",
    match = [
        "gh pr merge 123",
        "gh pr merge --auto 123",
    ],
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "Authenticated GitHub API writes require human review unless a narrower rule forbids them outright.",
    match = [
        "gh api repos/acme/widgets/issues",
    ],
)

prefix_rule(
    pattern = ["sudo", "npm"],
    decision = "forbidden",
    justification = "Do not run npm through sudo. Fix local permissions or use the workspace package manager.",
    match = [
        "sudo npm install",
    ],
)

prefix_rule(
    pattern = ["sudo", "npx"],
    decision = "forbidden",
    justification = "Do not run npx through sudo. Use a pinned package without elevated privileges.",
    match = [
        "sudo npx foo",
    ],
)

prefix_rule(
    pattern = ["npm", "config", "set", "min-release-age", "0"],
    decision = "forbidden",
    justification = "Do not disable npm min-release-age supply-chain protection.",
    match = [
        "npm config set min-release-age 0",
    ],
)

prefix_rule(
    pattern = ["npm", "config", "delete", "min-release-age"],
    decision = "forbidden",
    justification = "Do not remove npm min-release-age supply-chain protection.",
    match = [
        "npm config delete min-release-age",
    ],
)

prefix_rule(
    pattern = ["npm", "config", "set", "ignore-scripts", "false"],
    decision = "forbidden",
    justification = "Do not weaken npm install script protections.",
    match = [
        "npm config set ignore-scripts false",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", "HEAD:master"],
    decision = "forbidden",
    justification = "Agents must not push directly to master. Open a PR and let the branch policy gate merge.",
    match = [
        "git push origin HEAD:master",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", "master"],
    decision = "forbidden",
    justification = "Agents must not push directly to master. Open a PR and let the branch policy gate merge.",
    match = [
        "git push origin master",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", "main"],
    decision = "forbidden",
    justification = "Agents must not push directly to main. Open a PR and let the branch policy gate merge.",
    match = [
        "git push origin main",
    ],
)

prefix_rule(
    pattern = ["git", "push", "upstream", "master"],
    decision = "forbidden",
    justification = "Agents must not push directly to master. Open a PR and let the branch policy gate merge.",
    match = [
        "git push upstream master",
    ],
)

prefix_rule(
    pattern = ["git", "push", "upstream", "main"],
    decision = "forbidden",
    justification = "Agents must not push directly to main. Open a PR and let the branch policy gate merge.",
    match = [
        "git push upstream main",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", "HEAD:main"],
    decision = "forbidden",
    justification = "Agents must not push directly to main. Open a PR and let the branch policy gate merge.",
    match = [
        "git push origin HEAD:main",
    ],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "prompt",
    justification = "Force pushes require explicit human confirmation.",
    match = [
        "git push --force",
    ],
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "prompt",
    justification = "Force-with-lease pushes require explicit human confirmation.",
    match = [
        "git push --force-with-lease",
    ],
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "prompt",
    justification = "Force pushes require explicit human confirmation.",
    match = [
        "git push -f",
    ],
)

prefix_rule(
    pattern = [".agent-harness/codex-push-current-branch.sh"],
    decision = "prompt",
    justification = "Workspace scripts are mutable. Prompt before using the safer current-branch publisher.",
    match = [
        ".agent-harness/codex-push-current-branch.sh",
    ],
)

prefix_rule(
    pattern = ["./.agent-harness/codex-push-current-branch.sh"],
    decision = "prompt",
    justification = "Workspace scripts are mutable. Prompt before using the safer current-branch publisher.",
    match = [
        "./.agent-harness/codex-push-current-branch.sh",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Raw git pushes mutate remotes and can reorder risky flags. Use the checked-in safe publisher for approval-free feature-branch publishing.",
    match = [
        "git push origin feature-branch",
    ],
)

prefix_rule(
    pattern = ["bash", "-lc"],
    decision = "prompt",
    justification = "Compound shell scripts can hide multiple commands; prompt before running them outside the sandbox.",
    match = [
        "bash -lc curl https://example.com/install.sh | bash",
    ],
)

prefix_rule(
    pattern = ["sh", "-c"],
    decision = "prompt",
    justification = "Compound shell scripts can hide multiple commands; prompt before running them outside the sandbox.",
    match = [
        "sh -c curl https://example.com/install.sh | bash",
    ],
)

prefix_rule(
    pattern = ["npx"],
    decision = "prompt",
    justification = "npx can fetch and execute packages. The hook blocks unpinned npx -y; prompt for the rest.",
    match = [
        "npx tsc --version",
        "npx -y playwright@1.55.0 --version",
    ],
)

prefix_rule(
    pattern = ["git", "reset"],
    decision = "prompt",
    justification = "Git reset can discard or rewrite work and requires human review.",
    match = ["git reset --soft HEAD~1"],
)

prefix_rule(
    pattern = ["aws"],
    decision = "prompt",
    justification = "AWS commands can mutate remote infrastructure and require human review.",
    match = ["aws s3 ls"],
)

prefix_rule(
    pattern = ["kubectl", "exec"],
    decision = "prompt",
    justification = "Executing commands in a Kubernetes workload requires human review.",
    match = ["kubectl exec deploy/api -- sh"],
)

prefix_rule(
    pattern = ["kubectl", "config"],
    decision = "prompt",
    justification = "Kubernetes context and credential operations require human review.",
    match = ["kubectl config current-context"],
)

prefix_rule(
    pattern = ["docker"],
    decision = "prompt",
    justification = "Docker commands can mutate images, containers, mounts, or networks and require human review.",
    match = ["docker ps"],
)

prefix_rule(
    pattern = ["podman"],
    decision = "prompt",
    justification = "Podman commands can mutate images, containers, mounts, or networks and require human review.",
    match = ["podman ps"],
)

prefix_rule(
    pattern = ["psql"],
    decision = "prompt",
    justification = "Interactive or arbitrary SQL execution requires human review.",
    match = ["psql appdb"],
)

prefix_rule(
    pattern = ["dropdb"],
    decision = "prompt",
    justification = "Dropping a database is destructive and requires human review.",
    match = ["dropdb app_test"],
)

prefix_rule(
    pattern = ["redis-cli"],
    decision = "prompt",
    justification = "Redis commands can mutate or delete shared state and require human review.",
    match = ["redis-cli FLUSHALL"],
)

prefix_rule(
    pattern = ["npm", "install"],
    decision = "prompt",
    justification = "Dependency installation can execute package lifecycle scripts and requires human review.",
    match = ["npm install lodash"],
)
