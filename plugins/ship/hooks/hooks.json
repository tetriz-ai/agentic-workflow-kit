{
  "description": "PR nudges (full feedback fetch, PR body sync, Codex sweep arming) and the PR-description drift reminder after a push.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/hook-once.sh pr-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/hook-once.sh check-pr-description-drift.sh",
            "timeout": 10,
            "if": "Bash(git push:*)"
          }
        ]
      }
    ]
  }
}
