{
  "name": "plan",
  "version": "0.1.0",
  "description": "Tech design docs (RFCs) written fork by fork, their review, task breakdowns into shippable slices, and ADRs. Tested on Claude Code 2.1.289+ and Codex CLI 0.159.0+.",
  "author": {
    "name": "tetriz-ai"
  },
  "homepage": "https://github.com/tetriz-ai/agentic-workflow-kit/tree/main/plugins/plan",
  "repository": "https://github.com/tetriz-ai/agentic-workflow-kit",
  "license": "MIT",
  "keywords": [
    "design-doc",
    "rfc",
    "adr",
    "planning"
  ],
  "userConfig": {
    "base_branch": {
      "type": "string",
      "title": "Base branch",
      "description": "The branch pull requests target and reviews diff against.",
      "default": "main"
    },
    "rfc_dir": {
      "type": "string",
      "title": "Design doc folder",
      "description": "Where design docs (RFCs) live.",
      "default": "docs/rfc"
    },
    "adr_dir": {
      "type": "string",
      "title": "ADR folder",
      "description": "Where architecture decision records live.",
      "default": "docs/adr"
    }
  }
}
